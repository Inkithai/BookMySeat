{
  "name": "bookmyseat",
  "version": "1.0.0",
  "private": true,
  "description": "BookMySeat - Workshop Registration System for community training centres",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --disable-warning=ExperimentalWarning server/src/index.ts",
    "dev:web": "vite --config client/vite.config.ts",
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc -p tsconfig.server.json && node scripts/copy-sql.mjs",
    "build:web": "vite build --config client/vite.config.ts",
    "start": "node --disable-warning=ExperimentalWarning server/dist/index.js",
    "seed": "tsx --disable-warning=ExperimentalWarning server/src/db/seed-cli.ts",
    "test": "tsx --disable-warning=ExperimentalWarning --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p client/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "pg": "^8.23.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
