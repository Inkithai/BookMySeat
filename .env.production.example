# ---------------------------------------------------------------------------
# BookMySeat - production environment (Render web service "bookmyseat-api")
#
# Paste these into Render -> your service -> Environment -> "Add from .env".
# Replace the DATABASE_URL placeholders. Never commit the real values: the real
# file (.env.production) is git-ignored; only this example is tracked.
# ---------------------------------------------------------------------------

# Supabase -> Connect -> "Session pooler" (port 5432). Not "Direct connection".
# If your database password has symbols like @ # / ? : %, URL-encode them
# (e.g. @ -> %40) or reset the password to letters and digits only.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

NODE_VERSION=22
NODE_ENV=production
TZ=Asia/Colombo

# Fill an empty database with demo accounts + workshops on first start.
# Only runs while the users table is empty; it never touches existing data.
SEED_DEMO_DATA=true

DATABASE_POOL_SIZE=5
SESSION_TTL_DAYS=14

# Not needed on Render (it sets PORT itself):
# PORT=4000
# Only if your database does not use TLS (Supabase does - leave it unset):
# DATABASE_SSL=false

# ---------------------------------------------------------------------------
# Vercel (frontend) needs NO environment variables. Its only setting is the
# Render address inside vercel.json ("destination" of the /api rewrite).
# ---------------------------------------------------------------------------
